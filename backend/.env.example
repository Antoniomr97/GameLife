# ============================================================
# GameLife — Variables de Entorno
# Copia este archivo como .env y ajusta los valores.
# ============================================================

# Conexión a MySQL
# Formato: mysql+pymysql://usuario:contraseña@host:puerto/nombre_db
DATABASE_URL=mysql+pymysql://root:tu_password_aqui@localhost:3306/gamelife

# JWT
SECRET_KEY=cambiar-por-una-clave-secreta-segura-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configuración de Servidor de Correo (SMTP)
# Deja estos campos vacíos si no deseas habilitar el envío de correos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-usuario-email@gmail.com
SMTP_PASSWORD=tu-contraseña-de-aplicacion
SMTP_FROM_NAME=GameLife
SMTP_FROM_EMAIL=tu-usuario-email@gmail.com

